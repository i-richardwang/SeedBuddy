# Compose storage inputs
# PostgreSQL login used by Compose services.
POSTGRES_USER=seedbuddy
# PostgreSQL password used by Compose services.
POSTGRES_PASSWORD=seedbuddy
# PostgreSQL database created by the container.
POSTGRES_DB=seedbuddy
# RustFS access key shared with the application and bucket initializer.
RUSTFS_ACCESS_KEY=seedbuddy
# RustFS secret key shared with the application and bucket initializer.
RUSTFS_SECRET_KEY=seedbuddy
# Object bucket created by the Compose initializer.
BLOB_BUCKET=seedbuddy

# Shared authentication: copy this block into web/.env for source development.
# Session-signing secret, at least 32 random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public workbench origin and OAuth issuer; HTTPS except on localhost.
BETTER_AUTH_URL=
# Administrator email used only when the account directory is empty.
SEEDBUDDY_ADMIN_EMAIL=
# Initial administrator password, at least 12 characters.
SEEDBUDDY_ADMIN_PASSWORD=

# PostgreSQL container manifest; accepts an immutable mirror reference.
POSTGRES_IMAGE=postgres:18.6@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
# RustFS container manifest; accepts an immutable mirror reference.
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-rc.5@sha256:c36b3efea3d1e503f1a2581abd0e7611e0e5820dd30e1850a52384b3fc52bda4
# Bucket-initializer container manifest; accepts an immutable mirror reference.
AWS_CLI_IMAGE=amazon/aws-cli:2.36.34@sha256:cf1f5e5741c33f3fee383296ba8045b96b9eb93c3de017be6688fb00356352d7

# Optional CLI environment; export these in the invoking shell.
# Base URL used by seedctl when --server is omitted.
# SEEDBUDDY_SERVER_URL=http://localhost:3000
# Personal API key used by seedctl when --token is omitted.
# SEEDBUDDY_API_KEY=
# Worker profile root; defaults to ~/.seedbuddy.
# SEEDBUDDY_HOME=
# Private reference corpus read by the Python regression suite.
# SEEDBUDDY_REFERENCE_IMAGE_DIR=
# PyPI credential consumed by uv publish for the seedbuddy package.
# UV_PUBLISH_TOKEN=
