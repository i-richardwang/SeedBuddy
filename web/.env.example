# Workbench source development; add the shared authentication block from ../.env.example.
# PostgreSQL connection for application records.
DATABASE_URL=postgres://vitroflow:vitroflow@localhost:5432/vitroflow
# S3-compatible endpoint holding immutable blobs.
VITROFLOW_BLOB_ENDPOINT=http://localhost:9000
# S3-compatible bucket holding immutable blobs.
VITROFLOW_BLOB_BUCKET=vitroflow
# Object-store access key consumed by the AWS SDK.
AWS_ACCESS_KEY_ID=vitroflow
# Object-store secret consumed by the AWS SDK.
AWS_SECRET_ACCESS_KEY=vitroflow
# AWS signing region; defaults to us-east-1.
AWS_REGION=us-east-1
# Built HTTP server listening port; defaults to 3000.
# PORT=3000

# Optional integration-test inputs.
# PostgreSQL URL used by tests requiring independent database sessions.
# VITROFLOW_TEST_DATABASE_URL=postgres://vitroflow:vitroflow@localhost:5432/vitroflow
# S3 endpoint used by the blob-store contract test.
# VITROFLOW_TEST_S3_ENDPOINT=http://localhost:9000
# Bucket used by the blob-store contract test.
# VITROFLOW_TEST_S3_BUCKET=vitroflow
# Fail the S3 contract test when endpoint or bucket is absent; set by make check-s3.
# VITROFLOW_REQUIRE_S3_CONTRACT=1
# Process timezone exercised by calendar-day rendering tests.
# TZ=UTC
