  "dataset_add_name_placeholder": "seeds-2026-09",
  "dataset_add_new": "New dataset",
  "dataset_add_nothing_added": "Nothing was added",
  "dataset_add_result": [
    {
      "declarations": ["input added", "local formattedAdded = added: number"],
      "match": {
        "added=*": "{formattedAdded} added to {dataset}"
      }
    }
  ],
  "dataset_add_result_existing": [
    {
      "declarations": [
        "input added",
        "input existing",
        "local formattedAdded = added: number",
        "local formattedExisting = existing: number"
      ],
      "match": {
        "added=*": "{formattedAdded} added to {dataset}; {formattedExisting} already there"
      }
    }
  ],
