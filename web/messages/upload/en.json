{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "image_file_empty": "The file is empty",
  "image_file_too_large": [
    {
      "declarations": ["input megabytes", "local size = megabytes: number"],
      "match": {
        "megabytes=*": "The file exceeds {size} MiB"
      }
    }
  ],
  "image_file_unsupported": "Choose a JPEG, PNG, or TIFF image",
  "image_not_reduced": [
    {
      "declarations": [
        "input megapixels",
        "local formattedMegapixels = megapixels: number"
      ],
      "match": {
        "megapixels=*": "The photo has more than {formattedMegapixels} MP and this browser could not reduce it"
      }
    }
  ],
  "photos_not_added": "Photos not added: {files}"
}
