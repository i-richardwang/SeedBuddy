  "ui_no_data": "No data",
  "ui_page_loading": "Loading",
  "ui_pagination": "Pagination",
  "ui_pagination_next": "Next page",
  "ui_pagination_page": "Page {page}",
  "ui_pagination_previous": "Previous page",
  "ui_shell_collapse": "Collapse sidebar",
  "ui_shell_expand": "Expand sidebar",
  "ui_shell_open_navigation": "Open navigation",
  "ui_shell_sidebar": "Sidebar",
  "ui_shell_skip_to_content": "Skip to content",
  "ui_step_position": [
    {
      "declarations": [
        "input index",
        "input total",
        "local formattedIndex = index: number",
        "local formattedTotal = total: number"
      ],
      "match": {
        "index=*": "{formattedIndex} / {formattedTotal}"
      }
    }
  ],
  "ui_table_select_all": "Select all",
  "ui_text_not_copied": "Text not copied. Select the text and copy it manually.",
  "ui_viewport_fill": "Fill frame",
  "ui_viewport_zoom": "Zoom"
