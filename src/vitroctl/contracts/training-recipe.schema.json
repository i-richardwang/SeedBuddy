{
  "$id": "https://vitroflow.local/contracts/training-recipe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseModel": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "reference",
        "digest"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "properties": {
        "epochs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "patience": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "nbs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "imgsz": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3072,
          "multipleOf": 32
        },
        "optimizer": {
          "type": "string",
          "enum": [
            "auto",
            "SGD",
            "Adam",
            "AdamW",
            "NAdam",
            "RAdam",
            "RMSProp"
          ]
        },
        "lr0": {
          "type": "number",
          "minimum": 0.00001,
          "maximum": 0.1
        },
        "warmup_epochs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "mosaic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mixup": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "copy_paste": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_det": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deterministic": {
          "type": "boolean"
        },
        "scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "flipud": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fliplr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "translate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hsv_h": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hsv_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hsv_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "epochs",
        "patience",
        "batch",
        "imgsz",
        "optimizer",
        "lr0",
        "warmup_epochs",
        "mosaic",
        "mixup",
        "copy_paste",
        "max_det",
        "seed",
        "deterministic"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "const": "ultralytics"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "framework",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "baseModel",
    "parameters",
    "runtime"
  ],
  "additionalProperties": false
}
