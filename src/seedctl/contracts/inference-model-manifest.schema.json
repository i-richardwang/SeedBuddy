{
  "$id": "https://seedbuddy.local/contracts/inference-model-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "modelVersionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "classes": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "traditional"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ultralytics"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "weights": {
              "type": "object",
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "digest",
                "bytes"
              ],
              "additionalProperties": false
            },
            "inference": {
              "type": "object",
              "properties": {
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "imageSize": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxDetections": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "endToEnd": {
                  "type": "boolean"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "whole_image",
                    "dish"
                  ]
                }
              },
              "required": [
                "confidence",
                "imageSize",
                "maxDetections",
                "endToEnd",
                "mode"
              ],
              "additionalProperties": false
            },
            "validation": {
              "type": "object",
              "properties": {
                "precision": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "recall": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "map50": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "map50To95": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fitness": {
                  "type": "number"
                }
              },
              "required": [
                "precision",
                "recall",
                "map50",
                "map50To95",
                "fitness"
              ],
              "additionalProperties": false
            },
            "training": {
              "type": "object",
              "properties": {
                "baseModel": {
                  "type": "object",
                  "properties": {
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "reference",
                    "digest"
                  ],
                  "additionalProperties": false
                },
                "parameters": {
                  "type": "object",
                  "properties": {
                    "epochs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 300
                    },
                    "patience": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 300
                    },
                    "batch": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "nbs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "imgsz": {
                      "type": "integer",
                      "minimum": 320,
                      "maximum": 3072,
                      "multipleOf": 32
                    },
                    "optimizer": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "SGD",
                        "Adam",
                        "AdamW",
                        "NAdam",
                        "RAdam",
                        "RMSProp"
                      ]
                    },
                    "lr0": {
                      "type": "number",
                      "minimum": 0.00001,
                      "maximum": 0.1
                    },
                    "warmup_epochs": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "mosaic": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "mixup": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "copy_paste": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "max_det": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    },
                    "seed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "deterministic": {
                      "type": "boolean"
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "degrees": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 180
                    },
                    "flipud": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fliplr": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "translate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "hsv_h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "hsv_s": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "hsv_v": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "epochs",
                    "patience",
                    "batch",
                    "imgsz",
                    "optimizer",
                    "lr0",
                    "warmup_epochs",
                    "mosaic",
                    "mixup",
                    "copy_paste",
                    "max_det",
                    "seed",
                    "deterministic"
                  ],
                  "additionalProperties": false
                },
                "runtime": {
                  "type": "object",
                  "properties": {
                    "framework": {
                      "type": "string",
                      "const": "ultralytics"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "framework",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "baseModel",
                "parameters",
                "runtime"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "digest",
            "weights",
            "inference",
            "validation",
            "training"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "modelVersionId",
    "classes",
    "artifact"
  ],
  "additionalProperties": false
}
