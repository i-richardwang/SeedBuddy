{
  "$id": "https://seedbuddy.local/contracts/training-epoch-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "train": {
      "type": "object",
      "properties": {
        "box": {
          "type": "number"
        },
        "classification": {
          "type": "number"
        },
        "regression": {
          "type": "number"
        }
      },
      "required": [
        "box",
        "classification",
        "regression"
      ],
      "additionalProperties": false
    },
    "val": {
      "type": "object",
      "properties": {
        "box": {
          "type": "number"
        },
        "classification": {
          "type": "number"
        },
        "regression": {
          "type": "number"
        }
      },
      "required": [
        "box",
        "classification",
        "regression"
      ],
      "additionalProperties": false
    },
    "precision": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recall": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "map50": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "map50To95": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fitness": {
      "type": "number"
    },
    "learningRate": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "epoch",
    "train",
    "val",
    "precision",
    "recall",
    "map50",
    "map50To95",
    "fitness",
    "learningRate"
  ],
  "additionalProperties": false
}
