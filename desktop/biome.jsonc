{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**/*.ts", "scripts/**/*.ts"] },
  // Prettier formats; Biome lints and keeps imports in order:
  // node built-ins, then packages, then paths, each group sorted.
  "formatter": { "enabled": false },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              ":PATH:",
            ],
          },
        },
      },
    },
  },
}
